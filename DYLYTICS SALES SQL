        ,[Gender]

DELETE FROM [dbo].['Workplace Safety Data$']
WHERE [Gender]= 'FEMALE' AND [Plant]= 'ALABAMA'

SELECT [Plant] AS PLANT_GROUP
       ,[Gender]
       ,SUM([Incident Cost]) AS INCIDENTCOST_GROUP
       ,AVG ([Incident Cost])AS AVGCOST_GROUP
       ,COUNT(*)AS GROUP_COUNT
FROM [dbo].['Workplace Safety Data$']
