SELECT *
FROM [dbo].['Workplace Safety Data$']

SELECT DATE
       ,DEPARTMENT
       ,[INCIDENT COST]
       ,[Plant]

FROM [dbo].['Workplace Safety Data$']

--SQL WHERE CLAUSE
SELECT *
FROM [dbo].['Workplace Safety Data$']
WHERE [Plant] = 'Georgia'

SELECT [Injury Location]
       ,[Gender]
       ,[Department]
       ,[Plant]
FROM [dbo].['Workplace Safety Data$']
