--Windows function
---1. works as aggregate function
----2.Rank function 
-----3. Row number

-- when you want to get a single number, which maybe used for forcast and you don't want the to number to change
SELECT* 
,SUM([Incident Cost]) OVER() AS FORCAST_GUIDE
FROM [dbo].['Workplace Safety Data$']

SELECT* 
,SUM([Incident Cost]) OVER(PARTITION BY [Plant]) AS FORCAST_GUIDE
FROM [dbo].['Workplace Safety Data$']

--Row number is used to detect duplicate in your data set
SELECT *
        ,ROW_NUMBER() OVER (PARTITION BY [Gender] ORDER BY [Gender])
FROM [dbo].['Workplace Safety Data$']

SELECT *
        ,RANK() OVER (PARTITION BY[Incident Cost]  ORDER BY[Plant] DESC)
FROM [dbo].['Workplace Safety Data$']
